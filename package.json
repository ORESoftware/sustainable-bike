{
  "name": "sustainable-bike",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Parametric OpenSCAD research model for a captive-wheel, belt-drive, rear-hub-assist sustainable bicycle.",
  "scripts": {
    "generate": "node scripts/generate-config.mjs",
    "validate": "node scripts/validate-config.mjs && bash scripts/smoke-scad.sh",
    "test": "node --test tests/*.test.mjs",
    "render": "bash scripts/render.sh",
    "render:preview": "bash scripts/render-preview.sh",
    "check": "npm run test && npm run generate:check && npm run validate",
    "render:coupons": "PARTS=frame_coupon,tire_coupon RENDER_PREVIEW=0 bash scripts/render.sh",
    "generate:check": "node scripts/generate-config.mjs --check"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
